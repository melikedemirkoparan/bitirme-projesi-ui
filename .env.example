# Database (for local development without Docker)
DATABASE_URL=postgresql+psycopg://patent_user:patent_pass_password123@localhost:5433/patent_db

# PostgreSQL container settings
POSTGRES_USER=patent_user
POSTGRES_PASSWORD=patent_pass_password123
POSTGRES_DB=patent_db

# App
APP_HOST=0.0.0.0
APP_PORT=8000

# Local LLM — Ollama (used by Workspace Document Assistant)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Per-request timeout in seconds. Raise on slow hardware (long P2 prompts can
# take several minutes on a 7B model running on CPU/iGPU).
OLLAMA_TIMEOUT=600
